# _solmq_conn_util_posarg <verb> prints the completion kind for the verb's own
# positional argument, or nothing when it takes none.
_solmq_conn_util_posarg() {
  case "$1" in
    examples) print -n 'dir' ;;
    *) print -n '' ;;
  esac
}

_solmq_conn_util() {
  local -a verbs
  local verb='' cur prev kind
  local -i i positional=0

  cur="${words[CURRENT]}"
  prev=''
  (( CURRENT > 1 )) && prev="${words[CURRENT-1]}"

  # A value for the flag just typed wins over everything else.
  kind="$(_solmq_conn_util_flag_arg "$prev")"
  case "$kind" in
    file) _files; return ;;
    name) return ;;
  esac

  # words is 1-indexed and words[1] is the command, so the already-typed
  # arguments are 2..CURRENT-1. Flags and their values are skipped, because
  # they may appear before, after, or between the positional arguments.
  for (( i = 2; i < CURRENT; i++ )); do
    case "${words[i]}" in
      -*=*) ;;
      -*) [[ -n "$(_solmq_conn_util_flag_arg "${words[i]}")" ]] && (( i++ )) ;;
      *) if [[ -z "$verb" ]]; then verb="${words[i]}"; else (( positional++ )); fi ;;
    esac
  done

  # Aliases resolve to their canonical verb here, once, so the lookup
  # blocks above stay keyed by canonical verb names only.
  case "$verb" in
    gen) verb="generate" ;;
    dep) verb="deploy" ;;
    rm) verb="remove" ;;
    sts) verb="status" ;;
    ver) verb="version" ;;
    vld) verb="validate" ;;
    eg) verb="examples" ;;
  esac

  # Aliases are deliberately absent from this list -- the TAB menu for word 1
  # keeps showing only canonical verbs.
  if [[ -z "$verb" ]]; then
    verbs=(
      'generate:Render application.yml, or the artifacts for the resolved platform, to stdout or a file'
      'deploy:Generate for a platform, then apply it'
      'remove:Tear down what deploy created for a platform'
      'status:Ensure and run the status script, printing per-instance leader-election and workflow state'
      'version:Print the utility name, version, Go version and OS/arch'
      'validate:Lint the whole env.yaml + workflows'
      'examples:Write a starter env.yaml + workflows'
      'auto-complete:Print a shell completion script'
      'help:Print the usage summary (also -h, --help)'
      '-h:Print the usage summary'
      '--help:Print the usage summary'
    )
    _describe -t commands 'command' verbs
    return
  fi

  if [[ "$cur" == -* ]]; then
    _solmq_conn_util_flags "$verb"
    return
  fi

  if (( positional == 0 )); then
    _solmq_conn_util_targets "$verb" && return
    case "$(_solmq_conn_util_posarg "$verb")" in
      dir) _files -/; return ;;
      file) _files; return ;;
    esac
  fi
}

# Works both ways: autoloaded from $fpath, or sourced directly from a shell rc.
if [ "$funcstack[1]" = '_solmq_conn_util' ]; then
  _solmq_conn_util
else
  compdef _solmq_conn_util solmq-conn-util
fi
