  case "$1" in
    generate) f=('-e:config file, relative or absolute path (default: env.yaml)' '--env:config file, relative or absolute path (default: env.yaml)' '-o:write output to a file (default: stdout)' '--out:write output to a file (default: stdout)') ;;
    deploy) f=('-e:config file, relative or absolute path (default: env.yaml)' '--env:config file, relative or absolute path (default: env.yaml)' '--allow-command:approve an extra command binary beyond the command: allowlist; repeatable') ;;
    delete) f=('-e:config file, relative or absolute path (default: env.yaml)' '--env:config file, relative or absolute path (default: env.yaml)' '--allow-command:approve an extra command binary beyond the command: allowlist; repeatable') ;;
    validate) f=('-e:config file, relative or absolute path (default: env.yaml)' '--env:config file, relative or absolute path (default: env.yaml)') ;;
