  esac
}

_solmq_conn_util() {
  local -a verbs
  local verb='' arg1='' arg2='' cur prev kind
  local -i i positional=0

  cur="${words[CURRENT]}"
  prev=''
  (( CURRENT > 1 )) && prev="${words[CURRENT-1]}"

  # A value for the flag just typed wins over everything else.
  kind="$(_solmq_conn_util_flag_arg "$prev")"
  case "$kind" in
    file) _files; return ;;
    name) return ;;
  esac

  # words is 1-indexed and words[1] is the command, so the already-typed
  # arguments are 2..CURRENT-1. Flags and their values are skipped, because
  # they may appear before, after, or between the positional arguments.
  # arg1/arg2 capture the verb's first two positionals (target and, if the
  # target itself fans out into a further word, that word).
  for (( i = 2; i < CURRENT; i++ )); do
    case "${words[i]}" in
      -*=*) ;;
      -*) [[ -n "$(_solmq_conn_util_flag_arg "${words[i]}")" ]] && (( i++ )) ;;
      *)
        if [[ -z "$verb" ]]; then verb="${words[i]}"
        elif [[ -z "$arg1" ]]; then arg1="${words[i]}"; (( positional++ ))
        elif [[ -z "$arg2" ]]; then arg2="${words[i]}"; (( positional++ ))
        else (( positional++ )); fi
        ;;
    esac
  done

  # Aliases resolve to their canonical verb here, once, so the lookup
  # blocks above stay keyed by canonical verb names only.
  case "$verb" in
    gen) verb="generate" ;;
    dp) verb="deploy" ;;
    rm) verb="remove" ;;
    sts) verb="status" ;;
    lg) verb="logs" ;;
    ver) verb="version" ;;
    vld) verb="validate" ;;
    eg) verb="examples" ;;
    dl) verb="download" ;;
  esac

  # Aliases are deliberately absent from this list -- the TAB menu for word 1
  # keeps showing only canonical verbs.
  if [[ -z "$verb" ]]; then
    verbs=(
      'generate:Render application.yml, or the deploy artifacts for the resolved platform'
      'deploy:Generate for a platform, then apply it'
      'remove:Tear down what deploy created for a platform'
      'status:Report each instance: container (engine), application (connector), or all'
      'logs:Print each instance log, where status says what but not why'
      'version:Print the utility name, version, Go version and OS/arch'
      'validate:Lint the whole env.yaml + workflows'
      'examples:Write a starter env.yaml + workflows'
      'download:Download IBM MQ or syslog encoder jars and their dependencies'
      'auto-complete:Print a shell completion script'
      'help:Print this summary, or the help page of one command'
      '-h:Print the usage summary'
      '--help:Print the usage summary'
    )
    _describe -t commands 'command' verbs
    return
  fi

  if [[ "$cur" == -* ]]; then
    _solmq_conn_util_flags "$verb"
    return
  fi

  if (( positional == 0 )); then
    _solmq_conn_util_targets "$verb" && return
    case "$(_solmq_conn_util_posarg "$verb")" in
      dir) _files -/; return ;;
      file) _files; return ;;
    esac
  elif (( positional == 1 )); then
    _solmq_conn_util_sets "$verb" "$arg1" && return
  elif (( positional == 2 )); then
    if _solmq_conn_util_has_sets "$verb" "$arg1"; then
      case "$(_solmq_conn_util_posarg "$verb")" in
        dir) _files -/; return ;;
        file) _files; return ;;
      esac
    fi
  fi
}

