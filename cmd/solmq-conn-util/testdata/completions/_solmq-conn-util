# _solmq_conn_util_flag_arg <word> prints the value kind the flag consumes:
# 'file', 'name', or nothing. Boolean flags fall through to the catch-all.
_solmq_conn_util_flag_arg() {
  case "$1" in
    -e|--e|-env|--env) print -n 'file' ;;
    -o|--o|-out|--out) print -n 'file' ;;
    -allow-command|--allow-command) print -n 'name' ;;
    -platform|--platform) print -n 'name' ;;
    -url|--url) print -n 'name' ;;
    -version|--version) print -n 'name' ;;
    -omit-lib-file|--omit-lib-file) print -n 'file' ;;
    -output|--output) print -n 'name' ;;
    -pod|--pod) print -n 'name' ;;
    -container|--container) print -n 'name' ;;
    -namespace|--namespace) print -n 'name' ;;
    -management-port|--management-port) print -n 'name' ;;
    -user|--user) print -n 'name' ;;
    -command|--command) print -n 'name' ;;
    -tail|--tail) print -n 'name' ;;
    -since|--since) print -n 'name' ;;
    *) print -n '' ;;
  esac
}

# _solmq_conn_util_targets <verb> offers the verb's targets; 1 when it has none.
_solmq_conn_util_targets() {
  local -a t
  case "$1" in
    generate) t=('config:Emit application.yml') ;;
    status) t=('container:Report what the engine knows: state, restarts, age and image per instance' 'application:Report what the connector knows: leader-election state, health and workflows' 'all:Report both halves: the container table, then the application block per instance') ;;
    download) t=('jar:Download a set of jars and their dependencies into a directory') ;;
    auto-complete) t=('bash:Print the bash completion script' 'zsh:Print the zsh completion script' 'fish:Print the fish completion script' 'powershell:Print the PowerShell completion script') ;;
    *) return 1 ;;
  esac
  _describe -t targets 'target' t
  return 0
}

# _solmq_conn_util_sets <verb> <target> offers the target's own further
# words -- the third command level; 1 when it has none.
_solmq_conn_util_sets() {
  local -a s
  case "$1" in
    download)
      case "$2" in
        jar) s=('mq:Download the IBM MQ client jar and its dependencies' 'syslog:Download the logstash syslog encoder jar and its dependencies') ;;
        *) return 1 ;;
      esac
      ;;
    *) return 1 ;;
  esac
  _describe -t sets 'set' s
  return 0
}

# _solmq_conn_util_has_sets <verb> <target> reports whether the target
# itself fans out into a further word, without offering it -- used to gate
# the positional argument that can follow a set, since _solmq_conn_util_sets
# above calls _describe as a side effect and so cannot be used as a probe.
_solmq_conn_util_has_sets() {
  case "$1" in
    download)
      case "$2" in
        jar) return 0 ;;
        *) return 1 ;;
      esac
      ;;
    *) return 1 ;;
  esac
}

