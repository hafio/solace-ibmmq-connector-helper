#   rm -f ~/.zcompdump* && exec zsh
#
# _solmq_conn_util_flag_arg <word> prints the value kind the flag consumes:
# 'file', 'name', or nothing. Boolean flags fall through to the catch-all.
_solmq_conn_util_flag_arg() {
  case "$1" in
    -e|--e|-env|--env) print -n 'file' ;;
    -o|--o|-out|--out) print -n 'file' ;;
    -allow-command|--allow-command) print -n 'name' ;;
    -platform|--platform) print -n 'name' ;;
    -pod|--pod) print -n 'name' ;;
    -container|--container) print -n 'name' ;;
    -namespace|--namespace) print -n 'name' ;;
    -management-port|--management-port) print -n 'name' ;;
    -user|--user) print -n 'name' ;;
    -command|--command) print -n 'name' ;;
    *) print -n '' ;;
  esac
}

# _solmq_conn_util_targets <verb> offers the verb's targets; 1 when it has none.
_solmq_conn_util_targets() {
  local -a t
  case "$1" in
    generate) t=('config:Emit application.yml') ;;
    auto-complete) t=('bash:Print the bash completion script' 'zsh:Print the zsh completion script' 'fish:Print the fish completion script' 'powershell:Print the PowerShell completion script') ;;
    *) return 1 ;;
  esac
  _describe -t targets 'target' t
  return 0
}

